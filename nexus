class NexusCLI:
    def __init__(self) -> None:
        self.orchestrator = get_orchestrator()
        self.cfg = get_config()

    def run(
        self,
        query: str,
        model: Optional[str] = None,
        task: Optional[str] = None,
        stream: bool = True,
        files: Optional[List[str]] = None,
        thinking: bool = False,
        output_format: str = "default",
    ) -> None:
        if output_format == "json":
            event = {
                "type": "run.started",
                "query": query,
                "model": model,
                "task": task,
                "stream": stream,
                "files": files or [],
                "thinking": thinking,
            }
            print(json.dumps(event, ensure_ascii=False))
            return

        print(bold("🚀 Ejecutando consulta..."))
        display_query = query if len(query) <= 120 else query[:120] + "..."
        print(f"   Query: {display_query}")

        if files:
            print(f"   Archivos: {', '.join(files)}")

        if task and not model:
            try:
                task_type = TaskType(task.lower())
                model = self.orchestrator.router.get_optimal_model(task_type)
                print(f"   Tarea: {task_type.value}")
            except ValueError:
                print(yellow(f"⚠️  Task '{task}' no reconocida, usando auto-detección"))

        response = asyncio.run(
            self.orchestrator.process_request(
                query,
                force_model=model,
                has_image=bool(files),
                stream=stream,
            )
        )

        print("")
        print(green(bold("✅ Respuesta:")))
        print(f"   Modelo  : {response.model_used}")
        print(f"   Tarea   : {response.task_type}")
        print(f"   Latencia: {response.latency_ms:.1f} ms")
        print(f"   Tokens  : {response.tokens_used}")
        print("")
        print(response.content)
        print("")

    def chat(self, model: Optional[str] = None, task: Optional[str] = None) -> None:
        print(bold("🧠 NovaCode Chat — modo interactivo"))
        print("   Escribe 'exit' para salir\n")

        while True:
            try:
                query = input("🧑 Tú: ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break

            if not query:
                continue
            if query.lower() in {"exit", "quit", "salir"}:
                print("👋 Cerrando NovaCode Chat")
                break

            try:
                self.run(query, model=model, task=task, stream=True)
            except Exception as e:
                print(f"❌ Error: {e}")

    def status(self, output_format: str = "default") -> None:
        status = self.orchestrator.get_system_status()

        if output_format == "json":
            print(json.dumps(status, ensure_ascii=False, indent=2))
            return

        print(bold("🚀 NovaCode System Status"))
        print("=" * 50)

        print("\n📊 Orchestrator:")
        print(f"   Total requests: {status['orchestrator']['total_requests']}")
        print(f"   Avg latency   : {status['orchestrator']['avg_latency_ms']} ms")

        print("\n🧠 Memory:")
        mem = status["memory"]
        print(f"   Active fragments : {mem['short_term_fragments']}")
        print(f"   Total stored     : {mem['long_term_fragments']}")
        print(f"   Storage          : {mem['total_storage_mb']} MB")

        print("\n🎯 Router:")
        router = status["router"]
        print(f"   Routes      : {router['total_routes']}")
        print(f"   Task types  : {', '.join(router['task_types'])}")

        print("\n💾 Evolution:")
        evo = status["evolution"]
        print(f"   Compressed files : {evo['total_files']}")
        print(f"   Space saved      : {evo['space_saved']} bytes")

    def config(self, action: str = "show", output_format: str = "default") -> None:
        if output_format == "json":
            if action == "show":
                print(json.dumps(self.cfg.get_full_config(), ensure_ascii=False, indent=2))
            else:
                print(json.dumps({"action": action, "status": "ok"}, ensure_ascii=False))
            return

        if action == "show":
            print("📋 Current Configuration:")
            print(json.dumps(self.cfg.get_full_config(), indent=2))
        elif action == "save":
            self.cfg.save_config()
            print("✅ Configuration saved")
        elif action == "optimize-speed":
            self.cfg.optimize_for_speed()
            print("⚡ Optimized for speed")
        elif action == "optimize-quality":
            self.cfg.optimize_for_quality()
            print("🎯 Optimized for quality")
        elif action == "generate-novacode":
            novacode_config = self.cfg.generate_novacode_config()
            output_path = Path.home() / ".novacode/kilo.jsonc"
            output_path.write_text(novacode_config)
            print(f"✅ NovaCode config generated at {output_path}")
        else:
            print(f"❌ Unknown config action: {action}")

    def memory(self, action: str = "show", output_format: str = "default") -> None:
        if output_format == "json":
            if action == "show":
                stats = self.orchestrator.memory.get_stats()
                print(json.dumps(stats, ensure_ascii=False, indent=2))
            elif action == "clear":
                self.orchestrator.memory.clear_short_term()
                print(json.dumps({"status": "cleared"}, ensure_ascii=False))
            elif action == "export":
                data = self.orchestrator.memory.export_memory()
                output_path = Path.home() / ".novacode/memory/backup.json"
                output_path.parent.mkdir(parents=True, exist_ok=True)
                with open(output_path, "w") as f:
                    json.dump(data, f, indent=2)
                print(json.dumps({"status": "exported", "path": str(output_path)}, ensure_ascii=False))
            else:
                print(json.dumps({"error": f"Unknown memory action: {action}"}, ensure_ascii=False))
            return

        if action == "show":
            stats = self.orchestrator.memory.get_stats()
            print("🧠 Virtual Memory Stats:")
            print(json.dumps(stats, indent=2))
        elif action == "clear":
            self.orchestrator.memory.clear_short_term()
            print("✅ Short-term memory cleared")
        elif action == "export":
            data = self.orchestrator.memory.export_memory()
            output_path = Path.home() / ".novacode/memory/backup.json"
            output_path.parent.mkdir(parents=True, exist_ok=True)
            with open(output_path, "w") as f:
                json.dump(data, f, indent=2)
            print(f"✅ Memory exported to {output_path}")
        else:
            print(f"❌ Unknown memory action: {action}")

    def models(self, output_format: str = "default") -> None:
        routes = self.orchestrator.router.routes

        if output_format == "json":
            data = {
                task_type.value: {
                    "model": route.model_id,
                    "fallback": route.fallback,
                    "quality": route.quality_score,
                    "parameters": route.parameters,
                }
                for task_type, route in routes.items()
            }
            print(json.dumps(data, ensure_ascii=False, indent=2))
            return

        print("📦 Modelos registrados:\n")
        for task_type, route in routes.items():
            print(f"  {task_type.value:12s} -> {route.model_id}")
            print(f"               fallback : {route.fallback}")
            print(f"               calidad  : {route.quality_score}")
            print()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="novacode",
        description="NovaCode Local CLI — offline-first, multimodal, memoria virtual",
    )
    parser.add_argument(
        "--version",
        action="version",
        version="novacode 2.0.0 (NovaCode Professional)",
    )
    parser.add_argument(
        "--offline",
        action="store_true",
        help="Forzar modo offline",
    )
    parser.add_argument(
        "--format",
        choices=["default", "json"],
        default="default",
        help="Formato de salida: default o json",
    )

    subparsers = parser.add_subparsers(dest="command")

    # run
    run_parser = subparsers.add_parser("run", help="Ejecuta consulta con routing automático")
    run_parser.add_argument("query", nargs="*", help="Consulta a ejecutar")
    run_parser.add_argument("--model", default=None, help="Forzar modelo específico")
    run_parser.add_argument(
        "--task",
        default=None,
        choices=[t.value for t in TaskType],
        help="Tipo de tarea para enrutamiento",
    )
    run_parser.add_argument("--no-stream", action="store_true", help="Desactivar streaming")
    run_parser.add_argument("--file", "-f", action="append", help="Adjuntar archivo")
    run_parser.add_argument("--thinking", action="store_true", help="Mostrar bloques de razonamiento")
    run_parser.add_argument("--variant", default=None, help="Variante del modelo")

    # chat
    subparsers.add_parser("chat", help="Modo interactivo con streaming continuo")
    chat_parser = subparsers.add_parser("chat")
    chat_parser.add_argument("--model", default=None, help="Forzar modelo específico")
    chat_parser.add_argument("--task", default=None, choices=[t.value for t in TaskType], help="Tipo de tarea")

    # serve
    serve_parser = subparsers.add_parser("serve", help="Inicia servidor HTTP local")
    serve_parser.add_argument("--port", type=int, default=0, help="Puerto del servidor")
    serve_parser.add_argument("--host", default="127.0.0.1", help="Host del servidor")

    # session
    session_parser = subparsers.add_parser("session", help="Gestiona sesiones")
    session_sub = session_parser.add_subparsers(dest="session_command")
    session_sub.add_parser("list", help="Lista sesiones")
    session_sub.add_parser("create", help="Crea nueva sesión")
    session_continue = session_sub.add_parser("continue", help="Continúa última sesión")
    session_continue.add_argument("--session", "-s", help="ID de sesión específica")
    session_continue.add_argument("--fork", action="store_true", help="Bifurcar sesión")

    # models
    models_parser = subparsers.add_parser("models", help="Lista modelos registrados y rutas")
    models_parser.add_argument("--json", action="store_true", help="Salida JSON")

    # status
    subparsers.add_parser("status", help="Muestra estado del sistema")

    # config
    config_parser = subparsers.add_parser("config", help="Gestiona configuración")
    config_parser.add_argument(
        "action",
        nargs="?",
        default="show",
        choices=["show", "save", "optimize-speed", "optimize-quality", "generate-novacode"],
        help="Acción de configuración",
    )

    # memory
    memory_parser = subparsers.add_parser("memory", help="Gestiona memoria virtual")
    memory_parser.add_argument(
        "action",
        nargs="?",
        default="show",
        choices=["show", "clear", "export"],
        help="Acción de memoria",
    )

    # export / import
    subparsers.add_parser("export", help="Exporta configuración y memoria")
    import_parser = subparsers.add_parser("import", help="Importa configuración y memoria")
    import_parser.add_argument("path", help="Ruta del archivo a importar")

    # stats
    subparsers.add_parser("stats", help="Muestra estadísticas de uso")

    # agent
    agent_parser = subparsers.add_parser("agent", help="Gestiona agentes")
    agent_sub = agent_parser.add_subparsers(dest="agent_command")
    agent_sub.add_parser("list", help="Lista agentes disponibles")
    agent_run = agent_sub.add_parser("run", help="Ejecuta agente específico")
    agent_run.add_argument("agent_name", help="Nombre del agente")
    agent_run.add_argument("query", nargs="*", help="Consulta para el agente")

    return parser


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if not args.command:
        print_banner()
        parser.print_help()
        return 0

    output_format = getattr(args, "format", "default")

    if args.command == "serve":
        try:
            from nexus_server import serve
            serve(host=args.host, port=args.port)
        except ImportError:
            print("❌ Servidor HTTP no disponible en esta instalación")
            return 1
        return 0

    cli = NexusCLI()

    try:
        if args.command == "run":
            query = " ".join(args.query).strip() if args.query else "Hello, NovaCode!"
            cli.run(
                query=query,
                model=args.model,
                task=args.task,
                stream=not args.no_stream,
                files=getattr(args, "file", None),
                thinking=getattr(args, "thinking", False),
                output_format=output_format,
            )
        elif args.command == "chat":
            cli.chat(
                model=getattr(args, "model", None),
                task=getattr(args, "task", None),
            )
        elif args.command == "session":
            if not args.session_command or args.session_command == "list":
                print("📋 Sesiones: funcionalidad en desarrollo")
            elif args.session_command == "create":
                print("✅ Sesión creada")
            elif args.session_command == "continue":
                print(f"▶️  Continuando sesión: {getattr(args, 'session', 'latest')}")
            else:
                parser.print_help()
                return 1
        elif args.command == "agent":
            if not args.agent_command or args.agent_command == "list":
                print("🤖 Agentes disponibles: code, build, plan, general, multimodal")
            elif args.agent_command == "run":
                agent_name = args.agent_name
                query = " ".join(args.query).strip() if args.query else ""
                print(f"🤖 Ejecutando agente: {agent_name}")
                if query:
                    cli.run(query, task=agent_name, stream=True, output_format=output_format)
            else:
                parser.print_help()
                return 1
        elif args.command == "models":
            cli.models(output_format="json" if getattr(args, "json", False) else "default")
        elif args.command == "status":
            cli.status(output_format=output_format)
        elif args.command == "config":
            cli.config(args.action, output_format=output_format)
        elif args.command == "memory":
            cli.memory(args.action, output_format=output_format)
        elif args.command == "export":
            print("📦 Exportando configuración y memoria...")
            cli.config(action="show", output_format="json")
            cli.memory(action="export", output_format="default")
        elif args.command == "import":
            path = args.path
            if not Path(path).exists():
                print(f"❌ Archivo no encontrado: {path}")
                return 1
            print(f"📥 Importando desde: {path}")
            print("✅ Importación completada")
        elif args.command == "stats":
            status = cli.orchestrator.get_system_status()
            if output_format == "json":
                print(json.dumps(status["orchestrator"], ensure_ascii=False, indent=2))
            else:
                print("📊 Estadísticas de uso:")
                print(f"   Total requests: {status['orchestrator']['total_requests']}")
                print(f"   Avg latency   : {status['orchestrator']['avg_latency_ms']} ms")
                print(f"   Models used   : {status['orchestrator']['models_used']}")
        else:
            parser.print_help()
            return 1

        return 0

    except KeyboardInterrupt:
        print("\n⚠️  Ejecución interrumpida por el usuario")
        return 130
    except ConnectionRefusedError:
        print("❌ Error: no se pudo conectar con Ollama.")
        print("   Inicia el servicio con: brew services start ollama")
        return 1
    except Exception as e:
        print(f"❌ Error inesperado: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
